<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Browser.Base" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/chrome</item>
        <item name="android:colorPrimaryDark">@color/chrome</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/chrome</item>
        <item name="android:colorBackgroundFloating">@color/field</item>
        <item name="android:windowBackground">@color/chrome</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:statusBarColor">@color/chrome</item>
        <item name="android:navigationBarColor">@color/chrome</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
    </style>
    <style name="Theme.Browser" parent="Theme.Browser.Base" />
</resources>
